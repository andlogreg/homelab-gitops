# Non-secret Flux substitution vars for the ClusterSecretStore.
# VAULT_URL and AZURE_TENANT_ID are public Azure identifiers, not secrets — they live
# in a ConfigMap (not a Secret) and are seeded out-of-band per cluster (kept out of this
# public repo). Consumed via each cluster's infrastructure-configs postBuild.substituteFrom.
#
# ESO_CLIENT_ID is required only on Workload Identity clusters (the store's
# serviceAccountRef path): it is the client-id of the Azure identity ESO federates to,
# annotated onto the eso-azure-wi ServiceAccount. Omit it on ServicePrincipal clusters.
#
# Seed imperatively instead of copying this file, e.g.:
#   kubectl -n flux-system create configmap eso-vault-config \
#     --from-literal=VAULT_URL="https://<vault>.vault.azure.net/" \
#     --from-literal=AZURE_TENANT_ID="<tenant-guid>" \
#     --from-literal=ESO_CLIENT_ID="<client-guid>" \
#     --dry-run=client -o yaml | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: eso-vault-config
  namespace: flux-system
data:
  VAULT_URL: "PLACEHOLDER_VAULT_URL"
  AZURE_TENANT_ID: "PLACEHOLDER_TENANT_ID"
  # Workload Identity clusters only:
  ESO_CLIENT_ID: "PLACEHOLDER_CLIENT_ID"
